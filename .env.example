PORT=3000
# Without DATABASE_URL, local data is persisted in .data/postgres (PGlite).
# For production, use PostgreSQL 16+:
# DATABASE_URL=postgresql://fyj:password@localhost:5432/fyj
# NODE_ENV=production
# APP_ORIGIN=https://jobs.example.com
# Behind one trusted reverse proxy only:
# TRUST_PROXY=1
HH_USER_AGENT=FindYourJob/1.0
